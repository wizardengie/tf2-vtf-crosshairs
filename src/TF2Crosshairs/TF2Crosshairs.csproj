<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10, the SDK that ships with Visual Studio 2026. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TF2Crosshairs</AssemblyName>
    <RootNamespace>TF2Crosshairs</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <Version>1.2.0</Version>
    <Product>TF2 Weapon Crosshairs</Product>
    <Description>Assign a VTF crosshair to each Team Fortress 2 weapon.</Description>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO1000: designer-serialization hints on custom control properties; this app has no designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Single-file publish settings; pick self-contained or not on the command line (see build.ps1). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- compression is only allowed for self-contained bundles -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything the app needs is embedded, so the published output is a single exe. -->
    <EmbeddedResource Include="..\..\assets\crosshairs\*.vtf" LogicalName="crosshairs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\scripts\*.txt" LogicalName="scripts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\preview_bg.jpg" LogicalName="preview_bg.jpg" />
    <EmbeddedResource Include="..\..\assets\weapons.tsv" LogicalName="weapons.tsv" />
    <EmbeddedResource Include="..\..\assets\crosshairs.tsv" LogicalName="crosshairs.tsv" />
  </ItemGroup>

</Project>
